          <Pad Id="UalcArkygnDOQ20t6HYxzr" SlotId="LqnRAZM9hjUMig5Cftrz06" Bounds="540,480" />
          <Pad Id="RBSSQf05UqsMSbFMF3ITKZ" Bounds="561,784,498,260" ShowValueBox="true" isIOBox="true" Value="Calculates the 2D-homography matrix between a unit square centered at the origin and 4 given screen space points.&#xD;&#xA;&#xD;&#xA;Returns a transformation matrix, that maps the unit square to the screen points, which is useful to calibrate a projector to a rectangular projection surface.&#xD;&#xA;&#xD;&#xA;What you get is not an affine transformation, since its goal is to distort the original scene in a way that fits.&#xD;&#xA;The underlying assumption here is that the only way to get from those original points to screen points is a perspective view onto the source rectangle. By that you get a transformation, that when used as the projection transformation on a RenderWindow, also does the perspective correction of the content within that rectangle for you.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="CoreLibBasics.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
            <p:ValueBoxSettings>
              <p:fontsize p:Type="Int32">9</p:fontsize>
              <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
            </p:ValueBoxSettings>
          </Pad>
